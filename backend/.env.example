# ==============================================================================
# KA-CHING! BACKEND ENVIRONMENT VARIABLES TEMPLATE
# Copy this file to ".env" inside the /backend directory:
# ==============================================================================

# 1. Server & Logging Configuration
# Use NODE_ENV=development & DEBUG_LOGS=true locally; NODE_ENV=production & DEBUG_LOGS=false on Render
PORT=5000
NODE_ENV=development
DEBUG_LOGS=true

# 2. MongoDB Atlas Connection URI & JWT Signing Secret
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/kaching?retryWrites=true&w=majority
JWT_SECRET=your_jwt_secret_key_here

# 3. Google Cloud Vision OCR & Gemini Flash AI Keys
GOOGLE_VISION_API_KEY=your_google_cloud_vision_api_key
GEMINI_API_KEY=your_google_gemini_api_key

# 4. Official Support Email & Brevo Transactional Email API
APP_SUPPORT_EMAIL=your_support_email@example.com
BREVO_API_KEY=xkeysib-your_brevo_api_key_here