{
  "expo": {
    "name": "Ka-Ching!",
    "slug": "kaching-pfm",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/kaching_logo.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/images/kaching_logo.png",
      "resizeMode": "contain",
      "backgroundColor": "#F1ECE5"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.dggan.kaching"
    },
    "android": {
      "package": "com.dggan.kaching",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#FDF2C5",
        "foregroundImage": "./assets/images/kaching_logo.png"
      },
      "permissions": [
        "CAMERA",
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE",
        "VIBRATE",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK"
      ]
    },
    "web": {
      "favicon": "./assets/images/kaching_logo.png"
    },
    "plugins": ["expo-web-browser", "expo-status-bar", "expo-audio"],
    "extra": {
      "eas": {
        "projectId": "23745531-8eab-4339-98fc-2cc775f51453"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/23745531-8eab-4339-98fc-2cc775f51453"
    }
  }
}
