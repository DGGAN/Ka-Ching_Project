# ==============================================================================
# KA-CHING! FRONTEND ENVIRONMENT VARIABLES TEMPLATE
# Copy this file to ".env" inside the /frontend directory:
# ==============================================================================

# 1. Backend API & App Support Configuration
EXPO_PUBLIC_API_URL=https://kaching-backend-27o2.onrender.com/api
# EXPO_PUBLIC_API_URL=http://localhost:5000/api
EXPO_PUBLIC_SUPPORT_EMAIL=your_support_email@example.com

# 2. Google OAuth 2.0 Web Client ID (Format: xxxx.apps.googleusercontent.com)
EXPO_PUBLIC_GOOGLE_CLIENT_ID=

# 3. Developer Quick-Login Panel Toggle ("true" or "false")
EXPO_PUBLIC_ENABLE_DEV_SHORTCUTS=true

# 4. Preset Developer Test Personas (Matches backend/scripts/seedTestUsers.js)
# Persona 1: Standard 3-Month User + Balanced (50/30/20) + Auto-Capture ON
EXPO_PUBLIC_GOOGLE_EMAIL=kaching.pfmapp@gmail.com
EXPO_PUBLIC_GOOGLE_USERNAME=Ka-Ching Demo
EXPO_PUBLIC_GOOGLE_OAUTH_ID=109283746554321098765

